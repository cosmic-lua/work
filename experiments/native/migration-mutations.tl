return {
  ["accumulated_log"] = {["after"] = "logs[id][name] = nil", ["before"] = "logs[id][name] = blobs[entry.sha].content", ["file"] = "_work/migrate6_replay.tl", ["test"] = "_work/migrate6_test.tl"},
  ["acquisition_root"] = {["after"] = "id = batch, holder = st.holder", ["before"] = "id = st.root, holder = st.holder", ["file"] = "_work/migrate6_replay.tl", ["test"] = "_work/migrate6_test.tl"},
  ["activation_recheck"] = {["after"] = "if not same and false then return nil, drift end", ["before"] = "if not same then return nil, drift end", ["file"] = "_work/migrate6_publish.tl", ["test"] = "_work/migrate6_test.tl"},
  ["added_ref"] = {["after"] = "if expected[ref] == nil and false then", ["before"] = "if expected[ref] == nil then", ["file"] = "_work/migrate6_source.tl", ["test"] = "_work/migrate6_test.tl"},
  ["exact_message"] = {["after"] = 'data_block(c.verbatim and (msg .. "\\n") or (msg .. "\\n"))', ["before"] = 'data_block(c.verbatim and msg or (msg .. "\\n"))', ["file"] = "_work/fastimport.tl", ["test"] = "_work/migrate6_test.tl"},
  ["interrupted_candidate"] = {["after"] = "local _dropped, _drop_err = source.git(root, {\"update-ref\", \"-d\", REF})\n  local attempt = ksuid.new()", ["before"] = "local attempt = ksuid.new()", ["file"] = "_work/migrate6_replay.tl", ["test"] = "_work/migrate6_test.tl"},
  ["missing_live_state"] = {["after"] = "if head == \"\" then return true, \"\" end", ["before"] = "if head == \"\" then return false, \"catch-up refuses without a confirmed state head\" end", ["file"] = "_work/migrate6.tl", ["test"] = "_work/migrate6_test.tl"},
  ["observation_order"] = {["after"] = "after.observed_at < before.observed_at and false", ["before"] = "after.observed_at < before.observed_at", ["file"] = "_work/migrate6_freeze.tl", ["test"] = "_work/migrate6_freeze_test.tl"},
  ["pre_snapshot_freeze"] = {["after"] = "proof.frozen_at > cp.snapshot_at and false", ["before"] = "proof.frozen_at > cp.snapshot_at", ["file"] = "_work/migrate6_publish.tl", ["test"] = "_work/migrate6_test.tl"},
  ["prose_only"] = {["after"] = "(gitreadlog.prose_of(\"\") or \"\") .. (event.message:match(\"\\n\\n(.*)$\") or \"\")", ["before"] = "gitreadlog.prose_of(event.message:match(\"\\n\\n(.*)$\") or \"\")", ["file"] = "_work/migrate6_replay.tl", ["test"] = "_work/migrate6_logs_test.tl"},
  ["shallow_source"] = {["after"] = "if shallow:match(\"true\") and false then", ["before"] = "if shallow:match(\"true\") then", ["file"] = "_work/migrate6_source.tl", ["test"] = "_work/migrate6_test.tl"},
  ["shared_history"] = {["after"] = "if not present and false then shared.ids[#shared.ids + 1] = id;", ["before"] = "if not present then shared.ids[#shared.ids + 1] = id;", ["file"] = "_work/migrate6_source.tl", ["test"] = "_work/migrate6_test.tl"},
  probe_ruleset_rejection = {
    file = "_work/migrate6_freeze.tl",
    before = 'if not detail:find("GH013: Repository rule violations found for " .. ref, 1, true)\n      or not detail:find("push declined due to repository rule violations", 1, true) then',
    after = 'if false then', test = "_work/migrate6_freeze_test.tl",
  },
  probe_existing_ref = {
    file = "_work/migrate6_probes.tl",
    before = 'if tips[ref] ~= manifest.old_sha or manifest.receipts[ref] ~= manifest.old_sha then',
    after = 'if false and tips[ref] ~= manifest.old_sha or manifest.receipts[ref] ~= manifest.old_sha then',
    test = "_work/migrate6_freeze_test.tl",
  },
  probe_distinct_update = {
    file = "_work/migrate6_freeze.tl",
    before = '{"update", "--force", manifest.new_sha .. ":" .. manifest.refs[probes.key("update", namespace)]}',
    after = '{"update", "--force", manifest.old_sha .. ":" .. manifest.refs[probes.key("update", namespace)]}',
    test = "_work/migrate6_freeze_test.tl",
  },
  probe_exact_owned_tip = {
    file = "_work/migrate6_probes.tl",
    before = 'if out[local_ref] ~= manifest.old_sha then',
    after = 'if false and out[local_ref] ~= manifest.old_sha then',
    test = "_work/migrate6_freeze_test.tl",
  },
  probe_durable_manifest = {
    file = "_work/migrate6_probes.tl",
    before = 'local saved, serr = write(path, manifest); if not saved then return nil, serr end\n  end',
    after = 'local saved, serr = true, ""; if not saved then return nil, serr end\n  end',
    test = "_work/migrate6_freeze_test.tl",
  },
  replay_tree_graft = {
    file = "_work/fastimport.tl",
    before = 'if (op.tree or "") ~= "" then',
    after = 'if false and (op.tree or "") ~= "" then',
    test = "_work/fastimport_test.tl",
  },
  archive_canonical_path = {
    file = "_work/migrate6_replay.tl",
    before = 'if archive ~= nil then final_ops[#final_ops + 1] = modify("migration/sources", archive) end',
    after = 'if archive ~= nil then final_ops[#final_ops + 1] = modify("migration/source", archive) end',
    test = "_work/migrate6_test.tl",
  },
  archive_removed_ref = {
    file = "_work/migrate6_archive.tl",
    before = 'if actual[ref] == nil then out[#out + 1] = "archive: removed " .. ref',
    after = 'if actual[ref] ~= nil then out[#out + 1] = "archive: removed " .. ref',
    test = "_work/migrate6_freeze_test.tl",
  },
}
