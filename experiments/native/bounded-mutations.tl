return {
  four_attempts_instead_of_five = {
    file = "_work/statepublish.tl",
    before = 'for attempt = 1, 5 do',
    after = 'for attempt = 1, 4 do',
    test = "_work/statepublish_lifecycle_test.tl",
    filter = "test_five_failed_head_retries_retire_the_exact_attempt",
  },
  missing_dependency_cycle_witness = {
    file = "_work/graphguards.tl",
    before = 'if dep == id then',
    after = 'if dep == id and false then',
    test = "_work/graphguards_test.tl",
    filter = "test_dependency_cycle_has_an_independent_path_witness",
  },
  parent_depth_off_by_one = {
    file = "_work/graphguards.tl",
    before = 'local current = index[parent]\n  for _ = 1, item.MAX_DEPTH do',
    after = 'local current = index[parent]\n  for _ = 1, item.MAX_DEPTH + 1 do',
    test = "_work/graphguards_test.tl",
    filter = "test_parent_depth_limit_has_an_independent_boundary",
  },
  missing_handover_workload = {
    file = "_work/indexddl.tl",
    before = "WHEN claim <> '' OR handover_head <> '' OR pr <> 0 OR result <> ''",
    after = "WHEN claim <> '' OR pr <> 0",
    test = "_work/stategate_test.tl",
    filter = "test_bound_counts_handover_and_result",
  },
  pre_state_only_doing_bound = {
    file = "_work/stategate.tl",
    before = 'projected > flow.DOING_LIMIT and projected > previous',
    after = 'previous >= flow.DOING_LIMIT and projected >= 0',
    test = "_work/stategate_test.tl",
    filter = "test_bound_projects_the_complete_batch",
  },
  containers_count_as_doing = {
    file = "_work/indexddl.tl",
    before = 'AND NOT EXISTS (SELECT 1 FROM open_items c WHERE c.parent = i.id);',
    after = ';',
    test = "_work/stategate_test.tl",
    filter = "test_nonwork_does_not_consume_capacity",
  },
  rank_target_membership = {
    file = "_work/gitrank.tl",
    before = "statewrite.observe_path(s, \"items/\" .. id)",
    after = "statewrite.observe_path(s, \"items/\" .. parent_id)",
    test = "_work/gitrank_test.tl",
    filter = "test_rank_prepared_before_unpositioned_attach_loses",
  },
  attach_old_rank_membership = {
    file = "_work/stategate.tl",
    before = "if named_now and named_after then",
    after = "if named_now and named_after and false then",
    test = "_work/stategate_test.tl",
    filter = "test_attach_replay_requires_old_rank_pruning",
  },
  attach_new_parent_claim = {
    file = "_work/gitgraph.tl",
    before = "ipairs({parent, old_parent_id})",
    after = "ipairs({old_parent_id})",
    test = "_work/staterace_test.tl",
    filter = "test_bare_attach_refuses_a_foreign_claimed_parent",
  },
  attach_old_parent_claim = {
    file = "_work/gitgraph.tl",
    before = "ipairs({parent, old_parent_id})",
    after = "ipairs({parent})",
    test = "_work/staterace_test.tl",
    filter = "test_bare_attach_refuses_a_foreign_claimed_old_parent",
  },
  done_requires_membership_replay = {
    file = "_work/gitdone.tl",
    before = "role == \"outcome\" and reason == \"completed\", force, why)",
    after = "false, force, why)",
    test = "_work/gitdone_test.tl",
    filter = "test_done_prepared_before_open_child_attach_is_refused",
  },
  done_rechecks_absent_children = {
    file = "_work/stategate.tl",
    before = "if child.parent == id and item.is_open(child) then",
    after = "if child.parent == id and item.is_open(child) and false then",
    test = "_work/gitdone_test.tl",
    filter = "test_done_prepared_before_open_child_attach_is_refused",
  },
  take_rechecks_workability = {
    file = "_work/stategate.tl",
    before = "if role ~= \"work\" then",
    after = "if role ~= \"work\" and false then",
    test = "_work/staterace_test.tl",
    filter = "test_take_prepared_before_child_attach_rechecks_workability",
  },
  depend_rechecks_blocker = {
    file = "_work/stategate.tl",
    before = "if blocker == nil or not item.is_open(blocker) then",
    after = "if blocker == nil then",
    test = "_work/staterace_test.tl",
    filter = "test_depend_prepared_before_blocker_done_is_refused",
  },
  depend_rechecks_waiter = {
    file = "_work/stategate.tl",
    before = "if not item.is_open(it) then return \"depend gate: waiter is done: \" .. id end",
    after = "if not item.is_open(it) and false then return \"depend gate: waiter is done: \" .. id end",
    test = "_work/stategate_test.tl",
    filter = "test_depend_replay_refuses_a_completed_waiter",
  },
}
