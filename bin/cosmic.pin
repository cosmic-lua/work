# The trust root's one pin: the cosmic that builds this cosmic.
#
# Read by bin/cosmic with sed, so it stays two plain lines rather than a
# `*_pin.tl` — those are resolved by `cosmic --make fetch`, which needs a
# cosmic to run, which is the thing this pin provides. Bump both fields
# together; the sha is what is verified before anything is executed.
url = https://github.com/cosmic-lua/cosmic/releases/download/2026-09-04-2bf76ff/cosmic-lua
sha256 = 7f5c0f503de4bde1ecc58afc663dacc581bb4026e05829780548041e8f23ff86
