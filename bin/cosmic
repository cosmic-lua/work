#!/bin/sh
set -e

# The trust root, and the only host-shell step in the build.
#
# One job: obtain the ONE pinned artifact named in bin/cosmic.pin — a
# cosmic release — verify it, and exec it with whatever arguments it was
# given. Everything after that runs under that pin: `cosmic --make`
# extracts its own build engine from its own zip and resolves the rest of
# the tree's pins itself. So the chain is
#
#     kernel -> this script -> one pin -> everything else
#
# with POSIX sh, curl, a SHA-256 tool and standard host file utilities
# (including mktemp, link, wc and od) as the host surface.
#
#     bin/cosmic --make ci        run the gate
#     bin/cosmic --make build     build the binaries
#
# The verified download is assimilated to a native ELF before it is
# saved as the bootstrap -- sandboxed rules cannot grant the APE
# loader's extraction step, so an un-assimilated bootstrap fails inside
# the very build it is provisioning. That trade is one-way (the
# portable header does not come back), so this script keeps the
# pristine download too, beside it as `<bootstrap>.ape`: it is the base
# a downstream project builds onto when it declares no runtime of its
# own, and an ELF standing in for it would make every such artifact
# host-only under a fat binary's name. See `_make/artifact.tl`'s
# `bases_of` for what reads that sibling back.
#
# It prefers the tree's OWN cosmic when one exists, and reaches for the
# pin only on a cold start. Staleness is not this script's problem: the
# engine compares its own identity against what a rebuild produces and
# re-execs itself when the tree changed it (see _make/converge.tl), so
# the convergence logic lives in Teal where it can be tested and this
# stays dumb and auditable.
#
# WHICH BINARY RUNS YOUR SCRIPT, stated because it is not obvious and
# it matters most where nobody is looking for it:
#
#   bin/cosmic <script>   runs under o/bin/cosmic when one exists,
#                         else under the pin.
#
# For a gate verb that is the point -- a gate's answer is a statement
# about a toolchain, and converge makes sure it is the tree's. For a
# SCRIPT there is no convergence: it runs under whatever `o/` happens
# to hold, which may be several commits old.
#
# The sharp end is measurement. `bin/cosmic _perf/run.tl ...` measures
# the binary in `o/`, not the one your working tree describes, and a
# benchmark cannot tell you it read the wrong subject. Name the binary
# when the identity is the experiment: `o/bin/cosmic _perf/run.tl`
# after a build you just did, or the pinned release explicitly. See
# skills/optimize/measurement.md.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PIN="${SCRIPT_DIR}/cosmic.pin"
BOOTSTRAP="${ROOT}/o/bootstrap/cosmic"

verify_sha256() {
    # Usage: verify_sha256 <file> <expected-hex>. Returns non-zero on mismatch.
    file="$1"
    expected="$2"
    if command -v sha256sum >/dev/null 2>&1; then
        actual="$(sha256sum "${file}" | cut -d' ' -f1)"
    elif command -v shasum >/dev/null 2>&1; then
        actual="$(shasum -a 256 "${file}" | cut -d' ' -f1)"
    else
        echo "no sha256 tool available to verify ${file}" >&2
        return 1
    fi
    [ "${actual}" = "${expected}" ]
}

download() {
    # Usage: download <url> <dest>. Atomic, with retries on transient CDN
    # errors (e.g. 504 Gateway Timeout) that occasionally hit
    # unauthenticated GitHub release downloads.
    url="$1"
    dest="$2"
    dest_tmp="${dest}.tmp.$$"
    attempt=0
    until curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors \
        -o "${dest_tmp}" "${url}"; do
        attempt=$((attempt + 1))
        if [ "${attempt}" -ge 3 ]; then
            echo "Failed to download ${url} after ${attempt} attempts" >&2
            rm -f "${dest_tmp}"
            return 1
        fi
        echo "Retrying download of ${url} (attempt ${attempt})..." >&2
        sleep $((attempt * 5))
    done
    mv -f "${dest_tmp}" "${dest}"
}

# Cache candidates are data until a private copy passes the pin again.
bounded_regular() {
    [ ! -L "$1" ] && [ -f "$1" ] &&
        [ "$(wc -c < "$1")" -le 268435456 ]
}

cache_ancestors() {
    cache_parent=$(dirname "$shared")
    while [ "$cache_parent" != / ]; do
        if [ -L "$cache_parent" ] || { [ -e "$cache_parent" ] && [ ! -d "$cache_parent" ]; }; then
            echo "unsafe cache ancestor: $cache_parent" >&2
            return 1
        fi
        cache_parent=$(dirname "$cache_parent")
    done
}

shared_path() {
    shared=
    case "${XDG_CACHE_HOME:-}" in
        /*) cache_base=$XDG_CACHE_HOME ;;
        *) case "${HOME:-}" in
            /*) cache_base=$HOME/.cache ;;
            *) echo "runtime shared caching unavailable: no absolute cache base" >&2; return ;;
        esac ;;
    esac
    shared=$cache_base/cosmic/runtime/$sha256/cosmic.ape
}

copy_candidate() {
    if bounded_regular "$1" && cp "$1" "$ape_tmp" &&
        bounded_regular "$ape_tmp" && verify_sha256 "$ape_tmp" "$sha256"; then
        return 0
    fi
    echo "runtime rejected $1: not a bounded regular file or sha256 mismatch" >&2
    rm -f "$ape_tmp"
    return 1
}

publish_shared() {
    [ -n "$shared" ] || return 0
    cache_ancestors || return 1
    mkdir -p "$(dirname "$shared")" || return 1
    cache_ancestors || return 1
    if [ ! -e "$shared" ] && [ ! -L "$shared" ]; then
        cache_tmp=$(mktemp "$(dirname "$shared")/.cosmic-XXXXXXXXXX") || return 1
        if ! cp "$ape_tmp" "$cache_tmp" || ! bounded_regular "$cache_tmp" ||
            ! verify_sha256 "$cache_tmp" "$sha256"; then
            rm "$cache_tmp" || return 1
            return 1
        fi
        # POSIX link names the exact destination, including a directory winner.
        # C-locale errno is the diagnostic suffix, never arbitrary path text.
        if link_error=$(LC_ALL=C link "$cache_tmp" "$shared" 2>&1); then
            :
        else
            case "$link_error" in
                *": File exists") : ;;
                *) echo "$link_error" >&2; rm "$cache_tmp" || return 1; return 1 ;;
            esac
        fi
        rm "$cache_tmp" || return 1
    fi
    # Inspect a private snapshot even for an existing/concurrent winner.
    cache_check=$(mktemp "$(dirname "$shared")/.cosmic-XXXXXXXXXX") || return 1
    if ! bounded_regular "$shared" || ! cp "$shared" "$cache_check" ||
        ! bounded_regular "$cache_check" || ! verify_sha256 "$cache_check" "$sha256"; then
        echo "runtime cache publication rejected $shared" >&2
    fi
    rm "$cache_check" || return 1
}

ensure_bootstrap() {
    # Reuse or download, verify against the pin, keep pristine bytes as
    # `${BOOTSTRAP}.ape`, assimilate a COPY to a native ELF at
    # `${BOOTSTRAP}`, and stamp which pin produced the pair. The stamp
    # is a string compare on the hot path rather than a hash, and it is
    # what makes a pin bump reacquire (and re-assimilate) both files
    # instead of leaving local trees running the previous release.
    url="$(sed -n 's/^url *= *//p' "${PIN}")"
    sha256="$(sed -n 's/^sha256 *= *//p' "${PIN}")"
    if [ -z "${url}" ] || [ -z "${sha256}" ]; then
        echo "could not read url/sha256 from ${PIN}" >&2
        exit 1
    fi
    if [ -x "${BOOTSTRAP}" ] &&
        [ "$(cat "${BOOTSTRAP}.pin" 2>/dev/null)" = "${sha256}" ]; then
        return 0
    fi
    mkdir -p "${ROOT}/o/bootstrap"
    private=$(mktemp -d "${ROOT}/o/bootstrap/.cosmic-XXXXXXXXXX")
    trap 'rm -rf "$private"' EXIT HUP INT TERM
    ape_tmp=$private/cosmic.ape
    shared_path
    if copy_candidate "${BOOTSTRAP}.ape"; then
        :
    elif [ -n "$shared" ] && cache_ancestors && copy_candidate "$shared"; then
        :
    else
        echo "Downloading pinned cosmic..." >&2
        download "${url}" "${ape_tmp}" || exit 1
        if ! bounded_regular "$ape_tmp" || ! verify_sha256 "$ape_tmp" "$sha256"; then
            echo "pinned cosmic checksum verification failed; refusing to run" >&2
            exit 1
        fi
    fi
    publish_shared || { echo "runtime cache publication failed" >&2; exit 1; }
    chmod +x "${ape_tmp}"
    boot_tmp=$private/cosmic.boot
    cp "${ape_tmp}" "${boot_tmp}"
    if ! bounded_regular "$boot_tmp" || ! verify_sha256 "$boot_tmp" "$sha256"; then
        echo "private runtime checksum verification failed" >&2
        exit 1
    fi
    "${boot_tmp}" --assimilate
    if [ "$(head -c 4 "${boot_tmp}" | od -An -tx1 | tr -d ' \n')" != "7f454c46" ]; then
        echo "assimilation failed: still an APE — sandboxed rules need a native ELF (no loader grants)" >&2
        rm -f "${ape_tmp}" "${boot_tmp}"
        exit 1
    fi
    mv -f "${boot_tmp}" "${BOOTSTRAP}"
    mv -f "${ape_tmp}" "${BOOTSTRAP}.ape"
    printf '%s\n' "${sha256}" > "${BOOTSTRAP}.pin"
    rm -rf "$private"
    trap - EXIT HUP INT TERM
}

cd "${ROOT}"

# The tree's own binary, always, when the tree can produce one. Every
# gate has to run under it -- a gate's result is a statement about a
# toolchain, and this project builds the toolchain -- and it converges
# further by itself once running (_make/converge.tl).
#
# So: build it with the pin when it is missing and the pins are in
# hand, then hand over. The failure path is deliberate rather than
# checked -- the one verb that runs before any pin exists is `fetch`,
# and it falls through to the pin below, which is where it belongs.
BUILT="${ROOT}/o/bin/cosmic"
if [ ! -x "${BUILT}" ] && [ -d "${ROOT}/o/3p" ]; then
    ensure_bootstrap
    # Not checked with `set -e`: a failed tree build must fall through
    # to the pin below, not abort the script. But falling through
    # SILENTLY is its own bug for a non-gate verb (a gate's own build
    # failure is loud on its own terms) -- say so before the pin runs
    # in its place, so "why did my script run under an old release"
    # has an answer in this run's own output instead of nothing at all.
    if ! "${BOOTSTRAP}" --make build; then
        echo "cosmic: tree build failed; running pinned release $(sed -n 's/^url *= *//p' "${PIN}")" >&2
    fi
fi
if [ -x "${BUILT}" ]; then
    exec "${BUILT}" "$@"
fi

# Cold start. Always, so a cleaned o/ and a bumped pin are both just
# this path.
ensure_bootstrap
exec "${BOOTSTRAP}" "$@"
