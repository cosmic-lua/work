#!/usr/bin/env cosmic
local check = require("cosmic.check")
local child = require("cosmic.child")
local fs = require("cosmic.fs")
local fixture = require("_work.fixture")
local stateinit = require("_work.stateinit")
local store = require("_work.store")
local write = require("_work.storewrite")
local statewrite = require("_work.statewrite")
local publish = require("_work.publish")
local statepublish = require("_work.statepublish")
local staging = require("_work.statestaging")
local gitdraft = require("_work.gitdraft")
local boardread = require("_work.boardread")
local boardhistory = require("_work.boardhistory")
local refs = require("_work.refs")
local item = require("_work.item")
local ksuid = require("_work.ksuid")
local function setup(name: string): string
  local root = fs.join(fixture.tmpdir, name)
  assert(fs.remove_all(root) and fs.make_dirs(root))
  assert(stateinit.init(root))
  assert(check.must(child.run({"git", "config", "gitboard.mode", "local"}, {cwd = root})).ok)
  return root
end
local function new_item(title: string): item.Item
  return check.must(item.decode({id = ksuid.new(), title = title}))
end
local function test_native_save_log_and_no_legacy_refs()
  local root = setup("native-write-save")
  local s = check.must(store.open(root))
  local base = s.state_head
  local a, b = new_item("first"), new_item("second")
  write.set_session(s, "test")
  write.set_op(s, "new")
  assert(write.save(s, a, "new both by test", {change = "Spec", non_goals = ""}, {b}))
  assert(check.must(refs.read_ref(root, "refs/heads/state")) == base)
  assert(publish.publish(s))
  local history = check.must(boardhistory.read(root, s.state_head))
  assert(history.tip_by_id[a.id] == history.tip_by_id[b.id])
  assert(store.read_spec(s, a.id).change == "Spec")
  local loaded = check.must(store.load(s, a.id))
  local before = s.state_head
  local ok, err = write.save(s, loaded, "same")
  assert(ok and store.is_noop(err) and s.state_head == before)
  assert(statewrite.log(s, loaded, "note " .. a.id, "Persistent note"))
  assert(publish.publish(s))
  local snapshot = check.must(boardread.list(root, s.state_head))
  assert(snapshot.logs_by_id[a.id] ~= nil)
  assert(#check.must(refs.for_each_ref_raw(root, {"refs/heads/items", "refs/heads/ended", "refs/heads/claim-batches", "refs/heads/board/seq"})) == 0)
  assert(#check.must(staging.list(root)) == 0)
  assert(store.close(s))
end

local function test_disjoint_rebase_and_conflicting_reads()
  local root = setup("native-write-race")
  local seed = check.must(store.open(root))
  local a, b = new_item("a"), new_item("b")
  assert(write.save(seed, a, "new pair", nil, {b}) and publish.publish(seed))
  local left, right = check.must(store.open(root)), check.must(store.open(root))
  local la, rb = check.must(store.load(left, a.id)), check.must(store.load(right, b.id))
  la.title = "left"; rb.title = "right"
  assert(write.save(left, la, "set left") and write.save(right, rb, "set right"))
  assert(publish.publish(left))
  assert(publish.publish(right))
  local current = check.must(store.open(root))
  assert(check.must(store.load(current, a.id)).title == "left")
  assert(check.must(store.load(current, b.id)).title == "right")
  local loser = check.must(store.open(root))
  local stale = check.must(store.load(loser, a.id))
  stale.title = "stale"
  assert(write.save(loser, stale, "set stale"))
  local fresh = check.must(store.load(current, a.id)); fresh.title = "winner"
  assert(write.save(current, fresh, "set winner") and publish.publish(current))
  local ok, err = publish.publish(loser)
  assert(not ok and err == store.LOST_RACE, err)
  assert(loser.state_receipt == "" and loser.state_head == current.state_head)
  assert(#check.must(staging.list(root)) == 0)
  local recovered = check.must(store.load(loser, a.id)); recovered.title = "retry after reread"
  assert(write.save(loser, recovered, "retry after race") and publish.publish(loser))
  assert(#check.must(staging.list(root)) == 0)
end

local function test_draft_whole_chain()
  local root = setup("native-write-draft")
  local draft = check.must(gitdraft.begin(root))
  assert(gitdraft.activate(root, draft))
  local s = check.must(store.open(root))
  local a = new_item("draft a")
  local original = s.state_head
  check.must(write.save(s, a, "new draft"))
  check.must(publish.publish(s))
  a.title = "draft b"
  check.must(write.save(s, a, "set draft"))
  check.must(publish.publish(s))
  local frozen = check.must(staging.load(root, draft.staging_ref))
  assert(#frozen.transitions == 2)
  gitdraft.deactivate(root)
  assert(check.must(refs.read_ref(root, "refs/heads/state")) == original)
  assert(statepublish.execute(root, frozen))
  assert(statepublish.refresh(root, refs.board_remote(root)))
  local current = check.must(store.open(root))
  assert(check.must(store.load(current, a.id)).title == "draft b")
  local history = check.must(boardhistory.read(root, current.state_head))
  assert(#history.events_by_id[a.id] == 2)
end

local function test_remote_preparation_confirmation()
  local root = setup("native-write-remote")
  local remote = fs.join(fixture.tmpdir, "native-write-remote.git")
  assert(fs.remove_all(remote))
  assert(check.must(child.run({"git", "init", "--bare", "-q", remote})).ok)
  assert(check.must(child.run({"git", "remote", "add", "origin", remote}, {cwd = root})).ok)
  assert(check.must(child.run({"git", "push", "origin", "refs/heads/state", "refs/heads/board/format"}, {cwd = root})).ok)
  assert(check.must(child.run({"git", "fetch", "origin", "+refs/heads/state:refs/remotes/origin/state",
          "+refs/heads/board/format:refs/remotes/origin/board/format"}, {cwd = root})).ok)
  assert(check.must(child.run({"git", "config", "gitboard.mode", "remote"}, {cwd = root})).ok)
  local s = check.must(store.open(root))
  local original = s.state_head
  local a = new_item("remote pending")
  assert(write.save(s, a, "new pending"))
  assert(publish.publish(s))
  assert(s.state_head == original)
  local missing = store.load(s, a.id)
  assert(missing == nil)
  local all = check.must(staging.list(root))
  assert(#all == 1)
  assert(statepublish.execute(root, all[1]))
  assert(#check.must(staging.list(root)) == 1 and s.state_head == original)
  assert(statepublish.sync(s, true))
  assert(check.must(store.load(s, a.id)).title == "remote pending")
  assert(#check.must(staging.list(root)) == 0)
end

local function test_confirmation_keeps_receipts_when_destination_changes()
  local root = setup("native-write-destination")
  local original_url = fs.join(fixture.tmpdir, "expected-board.git")
  local alternate_url = fs.join(fixture.tmpdir, "different-board.git")
  assert(check.must(child.run({"git", "remote", "add", "origin", original_url}, {cwd = root})).ok)
  assert(check.must(child.run({"git", "config", "gitboard.repository", "fixture/board"}, {cwd = root})).ok)
  local s = check.must(store.open(root))
  local a = new_item("bound destination")
  assert(write.save(s, a, "new destination-bound"))
  local receipt = check.must(staging.load(root, s.state_receipt))
  local projected = check.must(statepublish.build(root, receipt))
  assert(refs.update_ref(root, "refs/heads/state", projected.candidate, projected.expected_head))
  assert(check.must(child.run({"git", "remote", "set-url", "origin", alternate_url}, {cwd = root})).ok)
  local wrong_url, uerr = statepublish.refresh(root, "origin")
  assert(not wrong_url and uerr == "prepared remote URL differs", uerr)
  assert(check.must(refs.read_ref(root, receipt.ref)) == receipt.sha)
  assert(check.must(child.run({"git", "remote", "set-url", "origin", original_url}, {cwd = root})).ok)
  assert(check.must(child.run({"git", "config", "gitboard.repository", "fixture/other"}, {cwd = root})).ok)
  local wrong_repo, rerr = statepublish.refresh(root, "origin")
  assert(not wrong_repo and rerr == "prepared repository destination differs", rerr)
  assert(check.must(refs.read_ref(root, receipt.ref)) == receipt.sha)
  assert(check.must(child.run({"git", "config", "gitboard.repository", "fixture/board"}, {cwd = root})).ok)
  assert(statepublish.refresh(root, "origin"))
  assert(check.must(refs.read_ref(root, receipt.ref)) == refs.ZERO_SHA)
end
