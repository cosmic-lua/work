--- What `_work/brieftmpl_gen.tl` generates, as data and pure
--- functions: which templates become which modules, the Teal source
--- each one compiles to, and the caller-fill tokens each declares.
---
--- Split from the generator so the generated modules can be checked
--- against their templates by an ordinary test — requiring the
--- generator itself would RUN it, and a drift guard that rewrites the
--- files it is checking proves nothing.

local template = require("cosmic.template")
local brieftext = require("_work.brieftext")
local brieftext_review = require("_work.brieftext_review")

--- One template: the module it becomes, the `_work.briefctx` record it
--- renders from, and its source text.
local record Unit
  name: string
  type_name: string
  text: string
end

--- Every brief template, in module order.
local UNITS < const >: {Unit} = {
  {name = "builder", type_name = "Builder", text = brieftext.BUILDER},
  {name = "rework", type_name = "Rework", text = brieftext.REWORK},
  {name = "research", type_name = "Research", text = brieftext.RESEARCH},
  {name = "refine", type_name = "Refine", text = brieftext.REFINE},
  {name = "decompose", type_name = "Decompose", text = brieftext.DECOMPOSE},
  {name = "review", type_name = "Review", text = brieftext_review.REVIEW},
  {name = "review_script", type_name = "ReviewScript",
    text = brieftext_review.REVIEW_SCRIPT},
  {name = "round", type_name = "Round", text = brieftext_review.ROUND},
}

--- The directory the generated renderers live in, relative to the root.
local OUT_DIR < const > = "_work/brieftmpl"

--- The caller-fill tokens a template declares, in first-seen order.
---
--- Read off the template's own interpolations: `{{.worktree}}` is the
--- token `<WORKTREE>` a brief leaves in place when the board cannot
--- answer that field. The list is the ORDER a brief reports its
--- survivors in, which is why it is derived from the one text that
--- declares them rather than restated by hand beside the resolution.
--- @param text string The template source
--- @return {string} The tokens, each once, in first-seen order
local function tokens_of(text: string): {string}
  local seen: {string: boolean} = {}
  local out: {string} = {}
  for field in text:gmatch("{{%.([%a_]+)}}") do
    local token = ("<%s>"):format(field:upper())
    if not seen[token] then
      seen[token] = true
      out[#out + 1] = token
    end
  end
  return out
end

--- One template's compiled renderer module.
---
--- The `{{type <Record> from _work.briefctx}}` declaration is prepended
--- here rather than carried in each template's own text, so the
--- templates stay pure prose and every one's line numbers — the
--- `-- <name>:<line>` source-map comments a type error is reported
--- against — line up with the constant they are written in.
--- @param u Unit The template
--- @return string | nil The generated Teal
--- @return string The refusal when the template is malformed
local function module_source(u: Unit): string | nil, string
  local src = ("{{type %s from _work.briefctx}}%s"):format(u.type_name, u.text)
  return template.compile(src, u.name)
end

--- The `_work/brieftmpl/fields.tl` module source.
--- @param units {Unit} The templates, in module order
--- @return string The generated Teal
local function fields_module(units: {Unit}): string
  local parts: {string} = {
    "--- GENERATED by `_work/brieftmpl_gen.tl` — do not edit.\n",
    "---\n",
    "--- The caller-fill tokens each brief template declares, in the\n",
    "--- template's own first-seen order: the order `_work.brief` reports\n",
    "--- the ones it could not resolve in.\n",
    "\n",
    "local record brieftmpl_fields\n",
  }
  for _, u in ipairs(units) do
    parts[#parts + 1] = ("  %s: {string}\n"):format(u.name)
  end
  parts[#parts + 1] = "end\n\nlocal M: brieftmpl_fields = {\n"
  for _, u in ipairs(units) do
    parts[#parts + 1] = ("  %s = {\n"):format(u.name)
    for _, token in ipairs(tokens_of(u.text)) do
      parts[#parts + 1] = ("    %q,\n"):format(token)
    end
    parts[#parts + 1] = "  },\n"
  end
  parts[#parts + 1] = "}\n\nreturn M\n"
  return table.concat(parts)
end

local record brieftmpl_source
  type Unit = Unit
  UNITS: {Unit}
  OUT_DIR: string
  tokens_of: function(text: string): {string}
  module_source: function(u: Unit): string | nil, string
  fields_module: function(units: {Unit}): string
end

local M: brieftmpl_source = {
  UNITS = UNITS,
  OUT_DIR = OUT_DIR,
  tokens_of = tokens_of,
  module_source = module_source,
  fields_module = fields_module,
}

return M
